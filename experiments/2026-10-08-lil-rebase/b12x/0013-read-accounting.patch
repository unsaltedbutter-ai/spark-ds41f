From 801b0f5bcf14cc5afa75958017c2fec143239549 Mon Sep 17 00:00:00 2001
From: Info <info@unsaltedbutter.ai>
Date: Sun, 18 Oct 2026 22:15:31 -0700
Subject: [PATCH 1/2] Instrument per-tensor checkpoint read amplification

Upstream-base: 236ddff04a5f5064084b46464800b70b34ec7d8c

B12X_READ_ACCOUNTING=1 records each tensor's logical payload and the
record envelope the current read plan asks the reader to fetch (full row
pitch for strided views). The summary is logged at the end of weight
loading and, with B12X_READ_ACCOUNTING_PATH, written as JSON with the top
20 contributors. Accounting only: no record, read or copy changes.

Quality: no numerical change; opt-in and inert when unset.
Tests: py_compile under Python 3.12; boot with B12X_READ_ACCOUNTING=1.
Upstream-status: local experiment, not submitted.
---
 b12x/integration/vllm/loader.py | 24 +++++++++++++
 b12x/loader/_checkpoint.py      | 63 ++++++++++++++++++++++++++++++++-
 2 files changed, 86 insertions(+), 1 deletion(-)

diff --git a/b12x/integration/vllm/loader.py b/b12x/integration/vllm/loader.py
index c49b39b..64afe75 100644
--- a/b12x/integration/vllm/loader.py
+++ b/b12x/integration/vllm/loader.py
@@ -148,6 +148,30 @@ class B12xModelLoader(DefaultModelLoader):
                 raise RuntimeError("device checkpoint loading requires vLLM's finish_weight_transfers routing hook")
             session.flush()
             stats = session.stats(flush=False)
+            accounting = session.read_accounting_summary()
+            if accounting is not None:
+                logger.info(
+                    "b12x read accounting: %.2f GB payload, %.2f GB record envelope, "
+                    "%.2fx potential amplification across %d tensors",
+                    accounting["payload_bytes"] / 1e9,
+                    accounting["envelope_bytes"] / 1e9,
+                    accounting["amplification"],
+                    accounting["tensors"],
+                )
+                for entry in accounting["top"][:10]:
+                    logger.info(
+                        "b12x read accounting: %s payload %.3f GB record envelope "
+                        "%.3f GB %.2fx (%d records)",
+                        entry["tensor"],
+                        entry["payload_bytes"] / 1e9,
+                        entry["envelope_bytes"] / 1e9,
+                        entry["amplification"],
+                        entry["records"],
+                    )
+                if session.read_accounting_path:
+                    Path(session.read_accounting_path).write_text(
+                        json.dumps(accounting, indent=2) + "\n"
+                    )
             summary = dict(group.summary) if group is not None else dict(
                 ranks=1, payload_bytes=stats["payload_bytes"],
                 physical_bytes=stats["physical_bytes"],
