+    def read_accounting_summary(self, top: int = 20) -> dict | None:
+        """Per-tensor payload vs read envelope, when B12X_READ_ACCOUNTING is set.
+
+        ``envelope_bytes`` is what the current record layout asks the reader to
+        fetch (full row pitch for strided views); ``payload_bytes`` is what the
+        model actually consumes. The ratio is the amplification the read plan
+        can remove. This is accounting only: it never changes a record.
+        """
+        if not self.read_accounting:
+            return None
+        entries = [
+            {
+                "tensor": name,
+                "payload_bytes": payload,
+                "envelope_bytes": envelope,
+                "amplification": envelope / payload if payload else 1.0,
+                "records": records,
+            }
+            for name, (payload, envelope, records) in self.read_accounting.items()
+        ]
+        entries.sort(
+            key=lambda entry: entry["envelope_bytes"] - entry["payload_bytes"],
+            reverse=True,
+        )
+        total_payload = sum(entry["payload_bytes"] for entry in entries)
+        total_envelope = sum(entry["envelope_bytes"] for entry in entries)
+        return {
+            "payload_bytes": total_payload,
+            "envelope_bytes": total_envelope,
+            "amplification": total_envelope / total_payload if total_payload else 1.0,
+            "tensors": len(entries),
+            "top": entries[:top],
+        }
+
     def stats(self, *, flush=True):
         if flush:
             self.flush()
