+    def _account_read(self, name, payload, envelope):
+        """Accumulate one tensor's logical bytes and its read envelope."""
+        if self.read_accounting is None:
+            return
+        bucket = self.read_accounting.get(name)
+        if bucket is None:
+            bucket = self.read_accounting[name] = [0, 0, 0]
+        bucket[0] += payload
+        bucket[1] += envelope
+        bucket[2] += 1
